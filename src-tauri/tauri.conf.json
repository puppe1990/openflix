{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlix",
  "version": "0.2.0",
  "identifier": "com.life-tv.app",
  "build": {
    "frontendDist": "../.tauri-dist/web",
    "beforeBuildCommand": "npm run tauri:dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenFlix",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
