{
  "name": "life-tv",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "10-foot Tauri player for your own Xtream/M3U, plus Prime Video and YouTube. No VPN, MAC cloud, or third-party streams.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppe1990/openflix.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "css": "tailwindcss -i web/input.css -o web/style.css",
    "css:watch": "tailwindcss -i web/input.css -o web/style.css --watch",
    "dev": "npm run css && python3 -m http.server 8792 --bind 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run css && npm run format:check && npm run lint && npm test",
    "tauri:dist": "npm run css && node scripts/make-tauri-dist.mjs",
    "tauri:dev": "npm run tauri:dist && cargo run --manifest-path src-tauri/Cargo.toml",
    "prepare": "husky",
    "postinstall": "node scripts/vendor-hls.mjs",
    "tauri:app": "bash scripts/build-macos-app.sh"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  }
}
